# ============================================================
#  НАСТРОЙКИ ПЕРЕВОДЧИКА RU <-> ИНГУШСКИЙ
#  Отредактируйте этот файл под свою машину. Больше ничего править не нужно.
# ============================================================

# ------------------------------------------------------------
# 1. ГДЕ ЛЕЖИТ МОДЕЛЬ
# ------------------------------------------------------------
# Папка, внутри которой лежат подпапки models/ и tokenizers/.
# По умолчанию — папка рядом с этим файлом.
#
# Windows: путь пишите через / или \\ (НЕ одиночный \)
#   ING_ROOT=D:/ing_translator
#   ING_ROOT=//server/share/ing_translator
# Linux:
#   ING_ROOT=/opt/ing_translator
#
# Оставьте пустым, чтобы использовать папку пакета.
ING_ROOT=

# ------------------------------------------------------------
# 2. РЕЖИМ РАБОТЫ
# ------------------------------------------------------------
# local  — модель грузится на этой же машине (нужна GPU 3090 или CPU)
# remote — этот ПК только показывает интерфейс, перевод считает
#          другая машина по сети (см. раздел 3)
ING_MODE=local

# ------------------------------------------------------------
# 3. РЕЖИМ remote: адрес машины с моделью
# ------------------------------------------------------------
# Заполнять ТОЛЬКО если ING_MODE=remote.
# На машине с 3090 запустите ЗАПУСТИТЬ_API.bat (или start_api.sh),
# затем впишите сюда её адрес в локальной сети:
#   ING_API_URL=http://192.168.1.50:8080
ING_API_URL=

# Токен доступа к API. Пусто = без пароля (только для доверенной локальной
# сети). Если задан — ДОЛЖЕН совпадать на обеих машинах.
ING_API_TOKEN=

# ------------------------------------------------------------
# 4. ЖЕЛЕЗО
# ------------------------------------------------------------
# auto — сама найдёт GPU, иначе CPU
# cuda — принудительно GPU (RTX 3090 и подобные)
# cpu  — принудительно процессор (медленно: 10-30 с на предложение)
ING_DEVICE=auto

# Точность вычислений:
#   float16  — для RTX 3090 / 2080 / T4  (РЕКОМЕНДУЕТСЯ для 3090)
#   bfloat16 — для RTX 40xx / A100 / H100
#   float32  — для CPU (выставится само, если GPU нет)
ING_DTYPE=float16

# ------------------------------------------------------------
# 5. СЕТЬ
# ------------------------------------------------------------
# Порт веб-интерфейса (открывается в браузере)
ING_UI_PORT=7860

# Порт API
ING_API_PORT=8080

# Кто может подключаться:
#   127.0.0.1 — только эта машина (безопасно, по умолчанию)
#   0.0.0.0   — любая машина в локальной сети
#               ОБЯЗАТЕЛЬНО для машины с 3090 в режиме remote!
ING_HOST=127.0.0.1

# ------------------------------------------------------------
# 6. КАЧЕСТВО ПЕРЕВОДА
# ------------------------------------------------------------
# Ширина луча: больше = лучше и медленнее. 4 — баланс, 1 — быстро.
ING_NUM_BEAMS=4

# Максимальная длина перевода в токенах
ING_MAX_LENGTH=128

# ============================================================
#  ТРЕБУЕМЫЕ ВЕРСИИ (справочно; ставятся автоматически)
# ============================================================
#
#  Python           3.10 - 3.12   (3.13 НЕ поддерживается)
#
#  torch            >= 2.1        для RTX 3090 — сборка с CUDA 12.1:
#                                 pip install torch --index-url \
#                                   https://download.pytorch.org/whl/cu121
#  transformers     == 4.44.2     ЖЁСТКО. На 4.46+ ломается загрузка
#                                 расширенного токенизатора (vocab 27381)
#  peft             >= 0.11,<0.20 адаптер LoRA r16
#  accelerate       >= 0.30
#  safetensors      >= 0.4
#  sentencepiece    >= 0.1.99
#  tokenizers       >= 0.19,<0.20 привязан к transformers 4.44
#
#  fastapi          >= 0.110,<0.116
#  uvicorn          >= 0.27
#  pydantic         >= 2.5
#  pyyaml           >= 6.0
#  requests         >= 2.31       (нужен только в режиме remote)
#
#  ПАМЯТЬ: модель 3.3B в float16 занимает ~7 ГБ VRAM.
#          На RTX 3090 (24 ГБ) помещается свободно.
#          На CPU нужно ~14 ГБ RAM и перевод идёт 10-30 с на предложение.
#
#  МЕСТО НА ДИСКЕ: ~13 ГБ (база 12 ГБ + адаптер 0.7 ГБ).
# ============================================================
