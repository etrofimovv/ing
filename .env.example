# ============================================================
#  НАСТРОЙКИ ПЕРЕВОДЧИКА RU -> ИНГУШСКИЙ
# ============================================================
# Скопируйте этот файл в ".env" (без .example) и правьте его.
# Пустое значение = используется значение по умолчанию.
# Кавычки не нужны. Строки с # — комментарии.
# ============================================================


# --- ГДЕ ЛЕЖАТ ФАЙЛЫ МОДЕЛИ -------------------------------
# Папка, внутри которой находятся models/ и tokenizers/.
# Пусто = папка, где лежит этот файл (рядом с serve/).
# Пример: D:\Модели\ing
ING_ROOT=


# --- РЕЖИМ РАБОТЫ -----------------------------------------
#   local  — модель работает на этом компьютере
#            (нужны файлы модели, ~13 ГБ, и много памяти)
#   remote — этот компьютер ничего не считает, а обращается
#            к другому компьютеру, где запущен сервер
#            (файлы модели НЕ нужны, запуск за секунды)
ING_MODE=local

# Адрес сервера — только для ING_MODE=remote
# Пример: http://192.168.1.50:8080
ING_API_URL=

# Токен доступа к серверу.
# Если задан — сервер принимает только запросы с этим токеном.
# Одинаковый на сервере и на клиентах. Пусто = без проверки.
ING_API_TOKEN=


# --- ОБОРУДОВАНИЕ -----------------------------------------
#   auto — видеокарта, если есть; иначе процессор
#   cuda — только видеокарта (ошибка, если её нет)
#   cpu  — только процессор (медленно: 3-60 сек на предложение)
ING_DEVICE=auto

# Точность вычислений: float16 / bfloat16 / float32
# На процессоре всегда float32 (это значение игнорируется).
ING_DTYPE=float16


# --- СЕТЬ --------------------------------------------------
# Порт веб-интерфейса. Если занят, программа возьмёт следующий.
ING_UI_PORT=7860

# Порт HTTP API.
ING_API_PORT=8080

# Кто может подключаться:
#   127.0.0.1 — только этот компьютер (безопасно)
#   0.0.0.0   — любой компьютер в вашей сети
#               (нужно, если к вам подключаются коллеги
#                или страница-сайт)
ING_HOST=127.0.0.1


# --- ДОСТУП С САЙТА (GitHub Pages) ------------------------
# Страница https://etrofimovv.github.io/ing/ обращается к
# вашему серверу прямо из браузера. Браузер блокирует такие
# запросы, если сайт не указан здесь (правило CORS).
#
# Пусто = разрешены https://etrofimovv.github.io и localhost.
# Несколько адресов — через запятую.
# "*" = любой сайт (только для локальной сети!).
ING_CORS_ORIGINS=


# --- КАЧЕСТВО ПЕРЕВОДА ------------------------------------
# Ширина поиска: больше = чуть лучше и заметно медленнее (1-8).
ING_NUM_BEAMS=4

# Максимальная длина результата в токенах.
ING_MAX_LENGTH=128
